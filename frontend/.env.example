# "api" (default) calls the Django backend; "mock" uses simulated sample data.
VITE_DATA_SOURCE=api

# Backend origin for production builds. Leave empty to use the dev proxy below.
VITE_API_BASE_URL=

# Where the dev server forwards /api requests.
API_PROXY_TARGET=http://127.0.0.1:8000

# Any MapLibre style URL. Defaults to the CARTO Voyager basemap.
VITE_MAP_STYLE_URL=
